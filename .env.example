# --- Gemini (all AI steps, Flash family only) ---
GEMINI_API_KEY=
# Comma-separated, tried in order. Re-check https://ai.google.dev/gemini-api/docs/deprecations the week you submit.
GEMINI_MODEL_CHAIN=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Set to 0 to disable the Flash-Lite rungs until the examiner confirms they count as "Gemini Flash"
ALLOW_FLASH_LITE=1
MAX_LLM_CALLS_PER_RUN=80
MAX_LLM_CALLS_PER_WEEK=150

# --- Supabase (server only, never NEXT_PUBLIC_) ---
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- Auth ---
CRON_SECRET=
CRON_SECRET_PREVIOUS=
ADMIN_PASSWORD=
SESSION_SECRET=
EXAMINER_TOKEN=

# --- Email (providers tried in order) ---
RESEND_API_KEY=
MAIL_FROM=Research Pulse <onboarding@resend.dev>
GMAIL_USER=
GMAIL_APP_PASSWORD=
RECIPIENT_EMAIL=

# --- Optional ---
BLOB_READ_WRITE_TOKEN=
HEALTHCHECK_DAILY_URL=
HEALTHCHECK_DELIVERY_URL=
PUBLIC_BASE_URL=
